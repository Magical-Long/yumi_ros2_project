      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file:///home/zhangjianglong/yumi_ws/src/yumi_description/meshes/gripper/coarse/finger.stl"/>
      </geometry>
    </collision>
  </link>
  
  <joint name="yumi_joint_gripper_l_finger_l" type="prismatic">
    <parent link="gripper_l_base"/>
    <child link="gripper_l_finger_l"/>
    <origin xyz="0 0.0065 0.0837" rpy="0 0 3.1416"/>
    <axis xyz="-1 0 0"/>
    <limit lower="0" upper="0.025" effort="300" velocity="0.02"/>
    <dynamics damping="0.5"/>
    <mimic joint="yumi_joint_gripper_l_finger_r"/>
  </joint>
  
  <link name="gripper_l_finger_l">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file:///home/zhangjianglong/yumi_ws/src/yumi_description/meshes/gripper/finger.stl"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file:///home/zhangjianglong/yumi_ws/src/yumi_description/meshes/gripper/coarse/finger.stl"/>
      </geometry>
    </collision>
  </link>
  
  
  <!--RIGHT FT SENSOR LINK-->
  <!-- 右臂同样在 link7 与 gripper base 之间插入力传感器固定关节。 -->
  <joint name="right_ee_ft_joint" type="fixed">
    <parent link="yumi_link_7_r"/>
    <child link="right_ee_ft_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.0"/>
  </joint>

  <!-- 右臂传感器中间 link，与左臂结构保持对称，便于统一处理 wrench。 -->
  <link name="right_ee_ft_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <!--RIGHT GRIPPER BASE-->
  <joint name="yumi_joint_8_r" type="fixed">
    <parent link="right_ee_ft_link"/>
    <child link="gripper_r_base"/>
    <origin rpy="0  0  3.1416" xyz="0 0 0.007"/>
  </joint>
  
  <link name="gripper_r_base">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file:///home/zhangjianglong/yumi_ws/src/yumi_description/meshes/gripper/base.stl"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file:///home/zhangjianglong/yumi_ws/src/yumi_description/meshes/gripper/coarse/base.stl"/>
      </geometry>
    </collision>
  </link>
  
  <!--LEFT GRIPPER FINGERS-->
  <joint name="yumi_joint_gripper_r_finger_r" type="prismatic">
    <parent link="gripper_r_base"/>
    <child link="gripper_r_finger_r"/>
    <origin xyz="0 -0.0065 0.0837" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="0" upper="0.025" effort="300" velocity="0.02"/>
    <dynamics damping="0.5"/>
  </joint>
  
  <link name="gripper_r_finger_r">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file:///home/zhangjianglong/yumi_ws/src/yumi_description/meshes/gripper/finger.stl"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file:///home/zhangjianglong/yumi_ws/src/yumi_description/meshes/gripper/coarse/finger.stl"/>
      </geometry>
    </collision>
  </link>
  
  <joint name="yumi_joint_gripper_r_finger_l" type="prismatic">
    <parent link="gripper_r_base"/>
    <child link="gripper_r_finger_l"/>
    <origin xyz="0 0.0065 0.0837" rpy="0 0 3.1416"/>
    <axis xyz="-1 0 0"/>
    <limit lower="0" upper="0.025" effort="300" velocity="0.02"/>
    <dynamics damping="0.5"/>
    <mimic joint="yumi_joint_gripper_r_finger_r"/>
  </joint>
  
  <link name="gripper_r_finger_l">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file:///home/zhangjianglong/yumi_ws/src/yumi_description/meshes/gripper/finger.stl"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file:///home/zhangjianglong/yumi_ws/src/yumi_description/meshes/gripper/coarse/finger.stl"/>
      </geometry>
    </collision>
  </link>
  
  
  
  
  
  <!--TRANSMISSIONS FOR ARM LINKS-->        

  <ros2_control name="yumi_gazebo_system" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>

    <joint name="yumi_joint_1_l"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0.0</param></state_interface><state_interface name="velocity"/></joint>
    <joint name="yumi_joint_2_l"><command_interface name="position"/><state_interface name="position"><param name="initial_value">-1.0</param></state_interface><state_interface name="velocity"/></joint>
    <joint name="yumi_joint_7_l"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0.0</param></state_interface><state_interface name="velocity"/></joint>
    <joint name="yumi_joint_3_l"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0.0</param></state_interface><state_interface name="velocity"/></joint>
    <joint name="yumi_joint_4_l"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0.0</param></state_interface><state_interface name="velocity"/></joint>
    <joint name="yumi_joint_5_l"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0.0</param></state_interface><state_interface name="velocity"/></joint>
    <joint name="yumi_joint_6_l"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0.0</param></state_interface><state_interface name="velocity"/></joint>

    <joint name="yumi_joint_1_r"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0.0</param></state_interface><state_interface name="velocity"/></joint>
    <joint name="yumi_joint_2_r"><command_interface name="position"/><state_interface name="position"><param name="initial_value">-1.0</param></state_interface><state_interface name="velocity"/></joint>
    <joint name="yumi_joint_7_r"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0.0</param></state_interface><state_interface name="velocity"/></joint>
    <joint name="yumi_joint_3_r"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0.0</param></state_interface><state_interface name="velocity"/></joint>
    <joint name="yumi_joint_4_r"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0.0</param></state_interface><state_interface name="velocity"/></joint>
    <joint name="yumi_joint_5_r"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0.0</param></state_interface><state_interface name="velocity"/></joint>
    <joint name="yumi_joint_6_r"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0.0</param></state_interface><state_interface name="velocity"/></joint>

    <!-- 仅接入夹爪主动关节状态，先不启用夹爪控制器，避免 MoveIt 认为机器人状态不完整 -->
    <joint name="yumi_joint_gripper_l_finger_r"><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="yumi_joint_gripper_r_finger_r"><state_interface name="position"/><state_interface name="velocity"/></joint>
  </ros2_control>

  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <robot_param>robot_description</robot_param>
      <robot_param_node>__ROBOT_PARAM_NODE__</robot_param_node>
      <parameters>__CONTROLLERS_YAML_PATH__</parameters>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin name="left_ee_force_torque_sensor_plugin" filename="libgazebo_ros_ft_sensor.so">
      <ros>
        <namespace>/</namespace>
        <remapping>wrench:=left_ee_wrench</remapping>
      </ros>
      <update_rate>250.0</update_rate>
      <joint_name>left_ee_ft_joint</joint_name>
      <gaussian_noise>0.0</gaussian_noise>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin name="right_ee_force_torque_sensor_plugin" filename="libgazebo_ros_ft_sensor.so">
      <ros>
        <namespace>/</namespace>
        <remapping>wrench:=right_ee_wrench</remapping>
      </ros>
      <update_rate>250.0</update_rate>
      <joint_name>right_ee_ft_joint</joint_name>
      <gaussian_noise>0.0</gaussian_noise>
    </plugin>
  </gazebo>
  <!-- preserveFixedJoint/provideFeedback 让固定关节不会被 Gazebo 合并掉，并提供 FT plugin 所需反馈。 -->
  <gazebo reference="left_ee_ft_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
    <provideFeedback>true</provideFeedback>
  </gazebo>
  <!-- 右臂固定关节同样需要保留和反馈，否则 /right_ee_wrench 可能没有有效接触信息。 -->
  <gazebo reference="right_ee_ft_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
    <provideFeedback>true</provideFeedback>
  </gazebo>
</robot>
