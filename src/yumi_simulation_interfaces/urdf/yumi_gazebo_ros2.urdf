  <!--LEFT FT SENSOR LINK-->
  <!-- 末端力传感器固定关节：Gazebo FT plugin 读取该 joint 上的约束反力/力矩。 -->
  <joint name="left_ee_ft_joint" type="fixed">
    <parent link="yumi_link_7_l"/>
    <child link="left_ee_ft_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.0"/>
  </joint>

  <!-- 传感器中间 link 用来在 link7 与 gripper base 之间插入可观测 wrench 的固定关节。 -->
  <link name="left_ee_ft_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <!--LEFT GRIPPER BASE-->
  <joint name="yumi_joint_8_l" type="fixed">
    <parent link="left_ee_ft_link"/>
    <child link="gripper_l_base"/>
    <origin rpy="0  0  3.1416" xyz="0 0 0.007"/>
  </joint>
  
  <link name="gripper_l_base">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
